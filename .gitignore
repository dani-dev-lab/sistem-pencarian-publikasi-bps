# Kredensial
.env

# Data unduhan (besar, dapat diambil ulang dari WebAPI BPS)
data/publikasi_pdf/
!data/publikasi_pdf/.gitkeep
data/sampel_pdf/*.pdf
*.db
*.sqlite3

# Cadangan sementara hasil ekstraksi (dibuat saat menguji perubahan parser)
data/*_cadangan.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Jejak pembaruan data (kunci PID + ringkasan hasil terakhir)
data/pembaruan.lock
data/pembaruan_terakhir.json
data/pembaruan_terakhir-uji.json
data/log_pembaruan/
data/pemeriksaan_domain.json

# Cache OCR per halaman (spike revisi 4); dibuat ulang dari PDF, besar.
data/ocr_cache/
# Log pengisian cache OCR (scripts/isi_cache_ocr.py).
data/log_ocr/

# Potret DB per kunci (7-8 MB per berkas, isinya bisa dibuat ulang dari DB)
data/regresi/*/potret/
