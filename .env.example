# Salin berkas ini menjadi .env lalu isi nilainya. JANGAN commit .env.
# Aplikasi MENOLAK berjalan kalau SECRET_KEY atau ADMIN_PASSWORD_HASH kosong.

# Kunci acak untuk mengamankan session login. Buat dengan:
#   venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Hash kata sandi halaman /admin/ (satu sandi bersama). Buat dengan:
#   venv\Scripts\python.exe scripts\buat_hash_sandi.py
# Sandi aslinya TIDAK disimpan di mana pun - hanya hash-nya.
ADMIN_PASSWORD_HASH=

# WebAPI BPS - daftar key di https://webapi.bps.go.id/developer/
BPS_API_KEY=
BPS_API_BASE_URL=https://webapi.bps.go.id/v1/api
BPS_DOMAIN=6300

# Database MySQL (Laragon). Ganti KATASANDI dengan sandi root MySQL Anda.
DATABASE_URL=mysql+pymysql://root:KATASANDI@localhost:3306/db_pencarian_bps
